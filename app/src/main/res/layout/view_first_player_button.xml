<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:ignore="SpUsage">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackground_vwFirstPlayerButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/round_button_size"
        android:backgroundTint="@color/darker_background"
        android:fontFamily="@font/bourbon_test_regular"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textColor="@color/font"
        app:cornerRadius="@dimen/default_corner_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/font"
        app:strokeWidth="@dimen/default_stroke_width" />

    <ImageView
        android:id="@+id/imvTeam_vwFirstPlayerButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="1dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/imvTeamOutline_vwFirstPlayerButton"
        app:layout_constraintEnd_toEndOf="@+id/imvTeamOutline_vwFirstPlayerButton"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/btnBackground_vwFirstPlayerButton"
        app:layout_constraintStart_toStartOf="@+id/imvTeamOutline_vwFirstPlayerButton"
        app:layout_constraintTop_toTopOf="@+id/imvTeamOutline_vwFirstPlayerButton"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/character_piece_empty_b" />

    <ImageView
        android:id="@+id/imvTeamOutline_vwFirstPlayerButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/txvTeam_vwFirstPlayerButton"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/character_piece_stroke" />

    <TextView
        android:id="@+id/txvTeam_vwFirstPlayerButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/bourbon_test_regular"
        android:text="@string/black_name"
        android:textColor="@color/font"
        android:textSize="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imvTeamOutline_vwFirstPlayerButton"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>