<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clyMain_vwWelcome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent_black"
    android:clickable="true"
    tools:ignore="SpUsage">

    <View
        android:id="@+id/vwBg_vwWelcome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="-16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="-16dp"
        android:background="@drawable/round_rect_gloden_outline_bg"
        app:layout_constraintBottom_toBottomOf="@+id/btnContinue_vwWelcome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txvTitle_vwWelcome"
        app:layout_constraintVertical_bias="1.0" />

    <ImageView
        android:id="@+id/imvCrown_vwWelcome"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:alpha="0.1"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/txvMessage_vwWelcome"
        app:layout_constraintEnd_toEndOf="@+id/vwBg_vwWelcome"
        app:layout_constraintStart_toStartOf="@+id/vwBg_vwWelcome"
        app:layout_constraintTop_toTopOf="@+id/txvMessage_vwWelcome"
        app:srcCompat="@drawable/icon_puzzle"
        app:tint="@color/app_golden" />

    <TextView
        android:id="@+id/txvTitle_vwWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/jost"
        android:text="@string/welcome_title"
        android:textColor="@color/app_golden"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintBottom_toTopOf="@+id/txvMessage_vwWelcome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txvMessage_vwWelcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        android:fontFamily="@font/jost"
        android:gravity="center"
        android:shadowColor="@color/black"
        android:shadowRadius="6"
        android:text="@string/welcome_message"
        android:textColor="@color/font"
        android:textSize="18dp"
        app:layout_constraintBottom_toTopOf="@+id/btnStartTutorial_vwWelcome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txvTitle_vwWelcome"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btnStartTutorial_vwWelcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        android:backgroundTint="@color/rules_button"
        android:fontFamily="@font/jost"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/learn_the_rules"
        android:textAllCaps="true"
        android:textColor="@color/font"
        android:textSize="@dimen/smaller_text_font_size"
        android:textStyle="bold"
        app:cornerRadius="@dimen/default_corner_radius"
        app:layout_constraintBottom_toTopOf="@+id/btnContinue_vwWelcome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txvMessage_vwWelcome"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btnContinue_vwWelcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:backgroundTint="@color/darker_background"
        android:fontFamily="@font/jost"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/welcome_button_continue"
        android:textAllCaps="true"
        android:textColor="@color/font"
        android:textSize="@dimen/smaller_text_font_size"
        android:textStyle="bold"
        app:cornerRadius="@dimen/default_corner_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnStartTutorial_vwWelcome"
        app:layout_constraintVertical_bias="0.0"
        app:strokeColor="@color/font"
        app:strokeWidth="@dimen/default_stroke_width" />

</androidx.constraintlayout.widget.ConstraintLayout>