<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".app.activities.puzzle.PuzzleSolverActivity"
    tools:ignore="SpUsage"
    tools:theme="@style/Theme.LeadersAndroidApp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gdlRoot_actPuzzleSolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="0dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gdl55h_actPuzzleSolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.55" />

    <com.leaders.app.views.decoration.DecorativeBackgroundView
        android:id="@+id/decorativeBackgroundView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone" />


    <com.leaders.app.views.puzzle.PuzzleRulesView
        android:id="@+id/prvRules_actPuzzleSolver"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/gdlRoot_actPuzzleSolver"
        app:layout_constraintVertical_bias="0.0" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack_actPuzzleSolver"
        android:layout_width="@dimen/round_button_size"
        android:layout_height="@dimen/round_button_size"
        android:layout_marginStart="8dp"
        android:background="@color/transparent"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/icon_back"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="@dimen/round_button_icon_size"
        app:iconTint="@color/font"
        app:layout_constraintBottom_toBottomOf="@+id/prvRules_actPuzzleSolver"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/gdlRoot_actPuzzleSolver"
        tools:ignore="SpeakableTextPresentCheck" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPuzzleActions_actPuzzleSolver"
        android:layout_width="@dimen/round_button_size"
        android:layout_height="@dimen/round_button_size"
        android:layout_marginEnd="8dp"
        android:background="@color/transparent"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/icon_more_actions"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="@dimen/round_button_icon_size"
        app:iconTint="@color/font"
        app:layout_constraintBottom_toBottomOf="@+id/prvRules_actPuzzleSolver"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/gdlRoot_actPuzzleSolver"
        tools:ignore="SpeakableTextPresentCheck" />

    <com.leaders.app.views.board.ReadOnlyBoardView
        android:id="@+id/bdvBoard_actPuzzleSolver"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintDimensionRatio="1024:1177"
        app:layout_constraintBottom_toTopOf="@+id/gdl55h_actPuzzleSolver"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/prvRules_actPuzzleSolver"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/txvSolutionsFound_actPuzzleSolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/bobby_jones_regular"
        android:text="@string/searching_solution"
        android:textColor="@color/font"
        android:textSize="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnPreviousSolution_actPuzzleSolver"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnPreviousSolution_actPuzzleSolver" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNextSolution_actPuzzleSolver"
        android:layout_width="@dimen/round_button_size"
        android:layout_height="@dimen/round_button_size"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/darker_background"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:visibility="invisible"
        app:icon="@drawable/icon_arrow_head"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="@dimen/round_button_icon_size"
        app:iconTint="@color/font"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/gdl55h_actPuzzleSolver"
        app:layout_constraintVertical_bias="0.0"
        app:strokeColor="@color/font"
        app:strokeWidth="@dimen/default_stroke_width"
        tools:ignore="SpeakableTextPresentCheck"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPreviousSolution_actPuzzleSolver"
        android:layout_width="@dimen/round_button_size"
        android:layout_height="@dimen/round_button_size"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/darker_background"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:rotationY="180"
        android:visibility="invisible"
        app:icon="@drawable/icon_arrow_head"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="@dimen/round_button_icon_size"
        app:iconTint="@color/font"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnNextSolution_actPuzzleSolver"
        app:layout_constraintVertical_bias="0.0"
        app:strokeColor="@color/font"
        app:strokeWidth="@dimen/default_stroke_width"
        tools:ignore="SpeakableTextPresentCheck"
        tools:visibility="visible" />

    <ProgressBar
        android:id="@+id/pgbSolutionsLoading_actPuzzleSolver"
        style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0.75"
        android:indeterminate="true"
        android:indeterminateBehavior="repeat"
        android:indeterminateTint="@color/app_golden"
        android:maxWidth="@dimen/solver_progress_bar_size"
        android:maxHeight="@dimen/solver_progress_bar_size"
        android:minWidth="@dimen/solver_progress_bar_size"
        android:minHeight="@dimen/solver_progress_bar_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnNextSolution_actPuzzleSolver"
        app:layout_constraintStart_toEndOf="@+id/btnPreviousSolution_actPuzzleSolver"
        app:layout_constraintTop_toBottomOf="@+id/txvSolutionsFound_actPuzzleSolver"
        app:layout_constraintVertical_bias="0.0" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/brrActionsTop_actPuzzleSolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="btnPreviousSolution_actPuzzleSolver,pgbSolutionsLoading_actPuzzleSolver" />

    <ImageView
        android:id="@+id/imvSolutionsBg_actPuzzleSolver"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="24dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/brrActionsTop_actPuzzleSolver"
        app:srcCompat="@drawable/round_rect" />

    <HorizontalScrollView
        android:id="@+id/scvActions_actPuzzleSolver"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="16dp"
        android:clickable="false"
        android:fadeScrollbars="false"
        android:fillViewport="false"
        android:scrollbarThumbHorizontal="@color/transparent_golden"
        android:scrollbars="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/imvSolutionsBg_actPuzzleSolver"
        app:layout_constraintEnd_toEndOf="@+id/imvSolutionsBg_actPuzzleSolver"
        app:layout_constraintStart_toStartOf="@+id/imvSolutionsBg_actPuzzleSolver"
        app:layout_constraintTop_toTopOf="@+id/imvSolutionsBg_actPuzzleSolver">

        <com.leaders.app.views.characteraction.CharacterActionTimelineView
            android:id="@+id/catvActions_actPuzzleSolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </HorizontalScrollView>

    <View
        android:id="@+id/vwDialogBg_actPuzzleSolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/transparent_black"
        android:clickable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.leaders.app.views.ActionsMenuView
        android:id="@+id/amvPuzzleActions_actPuzzleSolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/btnPuzzleActions_actPuzzleSolver"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnPuzzleActions_actPuzzleSolver"
        app:layout_constraintVertical_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>