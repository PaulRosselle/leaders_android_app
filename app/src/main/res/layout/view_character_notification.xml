<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    tools:ignore="SpUsage">

    <com.leaders.app.views.character.CardDescriptionView
        android:id="@+id/cdvMain_vwCharacterNotification"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    </com.leaders.app.views.character.CardDescriptionView>

    <View
        android:id="@+id/vwSeparator_vwCharacterNotification"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="8dp"
        android:background="@color/app_golden" />

    <com.leaders.app.views.character.CardDescriptionView
        android:id="@+id/cdvAdditional_vwCharacterNotification"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>