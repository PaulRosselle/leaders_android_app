<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"    
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:ignore="SpUsage">

    <TextView
        android:id="@+id/txvTitle_vwCharacterSkin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:autoSizeMaxTextSize="@dimen/smaller_text_font_size"
        android:autoSizeMinTextSize="14dp"
        android:autoSizeStepGranularity="1dp"
        android:autoSizeTextType="uniform"
        android:ellipsize="none"
        android:fontFamily="sans-serif"
        android:maxLines="2"
        android:text="@string/character_skins"
        android:textAllCaps="true"
        android:textColor="@color/font"
        android:textSize="@dimen/smaller_text_font_size"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnOpenForm_vwCharacterSkin"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenForm_vwCharacterSkin"
        android:layout_width="70dp"
        android:layout_height="@dimen/round_button_size"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/bobby_jones_regular"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:text="@string/choose"
        android:textColor="@color/app_golden"
        android:textSize="14dp"
        app:backgroundTint="@color/darker_background"
        app:cornerRadius="@dimen/default_corner_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/app_golden"
        app:strokeWidth="@dimen/default_stroke_width" />

</androidx.constraintlayout.widget.ConstraintLayout>