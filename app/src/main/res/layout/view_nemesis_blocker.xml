<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:ignore="SpUsage">

    <TextView
        android:id="@+id/txvTitle_vwNemesisBlocker"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/bobby_jones_regular"
        android:text="@string/enemy_nemesis_must_play"
        android:textColor="@color/app_golden"
        android:textSize="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/pgbLoading_vwNemesisBlocker"
        app:layout_constraintEnd_toStartOf="@+id/pgbLoading_vwNemesisBlocker"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/ptvPortrait_vwNemesisBlocker"
        app:layout_constraintTop_toTopOf="@+id/pgbLoading_vwNemesisBlocker" />

    <com.leaders.app.views.portrait.PortraitView
        android:id="@+id/ptvPortrait_vwNemesisBlocker"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:adjustViewBounds="true"
        app:displayMode="Hexagonal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/card_portrait_jailer" />

    <ProgressBar
        android:id="@+id/pgbLoading_vwNemesisBlocker"
        style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:alpha="0.75"
        android:indeterminate="true"
        android:indeterminateBehavior="repeat"
        android:indeterminateTint="@color/app_golden"
        android:maxWidth="@dimen/solver_progress_bar_size"
        android:maxHeight="@dimen/solver_progress_bar_size"
        android:minWidth="@dimen/solver_progress_bar_size"
        android:minHeight="@dimen/solver_progress_bar_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnInterrupt_vwNemesisBlocker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/ultra_dark_background"
        android:fontFamily="@font/bobby_jones_condensed"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:text="@string/interrupt"
        android:textColor="@color/font"
        android:textSize="20sp"
        app:cornerRadius="@dimen/default_corner_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pgbLoading_vwNemesisBlocker"
        app:layout_constraintVertical_bias="0.0"
        app:strokeColor="@color/font"
        app:strokeWidth="@dimen/default_stroke_width" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:autoSizeMaxTextSize="20dp"
        android:autoSizeMinTextSize="6dp"
        android:autoSizeStepGranularity="1dp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/bobby_jones_condensed"
        android:text="@string/searching_for_a_move_able_to_block_you"
        android:textColor="@color/font"
        android:textSize="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnInterrupt_vwNemesisBlocker"
        app:layout_constraintEnd_toStartOf="@+id/btnInterrupt_vwNemesisBlocker"
        app:layout_constraintStart_toEndOf="@+id/ptvPortrait_vwNemesisBlocker"
        app:layout_constraintTop_toTopOf="@+id/btnInterrupt_vwNemesisBlocker"
        app:layout_constraintVertical_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>