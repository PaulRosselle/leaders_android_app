<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/round_rect"
    tools:ignore="SpUsage">

    <ImageView
        android:id="@+id/imvIconBackground_vwExpansionCharactersSetup"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:cropToPadding="true"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/imvIcon_vwExpansionCharactersSetup"
        app:layout_constraintEnd_toEndOf="@+id/imvIcon_vwExpansionCharactersSetup"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/imvIcon_vwExpansionCharactersSetup"
        app:layout_constraintTop_toTopOf="@+id/imvIcon_vwExpansionCharactersSetup"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/round_rect"
        app:tint="@color/transparent_golden" />

    <ImageView
        android:id="@+id/imvIcon_vwExpansionCharactersSetup"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:scaleX="0.8"
        android:scaleY="0.8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/icon_expansion_base_game"
        app:tint="@color/expansion_base_game" />

    <TextView
        android:id="@+id/txvTitle_vwExpansionCharactersSetup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/bebas_neue_bold"
        android:includeFontPadding="true"
        android:justificationMode="inter_word"
        android:text="@string/group_name_leaders"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="22dp"
        app:layout_constraintBottom_toBottomOf="@+id/imvIcon_vwExpansionCharactersSetup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imvIcon_vwExpansionCharactersSetup"
        app:layout_constraintTop_toTopOf="@+id/imvIcon_vwExpansionCharactersSetup" />

    <ImageView
        android:id="@+id/imvChecked_vwExpansionCharactersSetup"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/checkbox"
        android:padding="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/imvIconBackground_vwExpansionCharactersSetup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imvIconBackground_vwExpansionCharactersSetup"
        app:srcCompat="@drawable/unchecked_box"
        app:tint="@color/white" />

    <LinearLayout
        android:id="@+id/llyPortraits_vwExpansionCharactersSetup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/txvTitle_vwExpansionCharactersSetup"
        app:layout_constraintStart_toStartOf="@+id/imvIcon_vwExpansionCharactersSetup"
        app:layout_constraintTop_toBottomOf="@+id/imvIcon_vwExpansionCharactersSetup"
        app:layout_constraintVertical_bias="0.0">
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>