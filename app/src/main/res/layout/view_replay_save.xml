<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/round_rect"
    tools:ignore="SpUsage">

    <TextView
        android:id="@+id/txvTitle_vwReplaySave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif"
        android:text="@string/save_game"
        android:textAllCaps="true"
        android:textColor="@color/app_golden"
        android:textSize="16dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/txvName_vwReplaySave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif"
        android:text="@string/game_name"
        android:textAllCaps="true"
        android:textColor="@color/font"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txvTitle_vwReplaySave"
        app:layout_constraintVertical_bias="0.0" />

    <EditText
        android:id="@+id/edtName_vwReplaySave"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/transparent"
        android:ems="10"
        android:fontFamily="@font/bobby_jones_condensed"
        android:foreground="@drawable/round_rect_stroke"
        android:foregroundTint="@color/darker_font"
        android:gravity="start"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLength="30"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="@color/font"
        android:textColorHint="@color/darker_font"
        android:textCursorDrawable="@drawable/text_cursor"
        android:textSize="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txvName_vwReplaySave"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="LabelFor" />

    <TextView
        android:id="@+id/txvDate_vwReplaySave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif"
        android:text="@string/game_date"
        android:textAllCaps="true"
        android:textColor="@color/font"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edtName_vwReplaySave"
        app:layout_constraintVertical_bias="0.0" />

    <EditText
        android:id="@+id/edtDate_vwReplaySave"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/transparent"
        android:cursorVisible="false"
        android:ems="10"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:fontFamily="@font/bobby_jones_regular"
        android:foreground="@drawable/round_rect_stroke"
        android:foregroundTint="@color/darker_font"
        android:importantForAutofill="no"
        android:inputType="none"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="@color/font"
        android:textColorHint="@color/darker_font"
        android:textIsSelectable="false"
        android:textSize="@dimen/default_text_font_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txvDate_vwReplaySave"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="LabelFor,TextFields"
        tools:text="31/12/2026" />


    <ImageView
        android:id="@+id/imvDate_vwReplaySave"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/edtDate_vwReplaySave"
        app:layout_constraintEnd_toEndOf="@+id/edtDate_vwReplaySave"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/edtName_vwReplaySave"
        app:layout_constraintTop_toTopOf="@+id/edtDate_vwReplaySave"
        app:srcCompat="@drawable/icon_calendar"
        app:tint="@color/font" />

    <TextView
        android:id="@+id/txvSave_vwReplaySave"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dialog_button_height"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:minWidth="@dimen/dialog_button_width"
        android:text="@string/ok"
        android:textAllCaps="true"
        android:textColor="@color/app_golden"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edtDate_vwReplaySave"
        app:layout_constraintVertical_bias="1.0" />


    <TextView
        android:id="@+id/txvCancel_vwReplaySave"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dialog_button_height"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:minWidth="@dimen/dialog_button_width"
        android:text="@string/cancel"
        android:textAllCaps="true"
        android:textColor="@color/app_golden"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/txvSave_vwReplaySave"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

</androidx.constraintlayout.widget.ConstraintLayout>