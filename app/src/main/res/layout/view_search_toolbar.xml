<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    tools:ignore="SpUsage">

    <EditText
        android:id="@+id/edtSearch_vwSearchToolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/round_button_size"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:background="@drawable/round_rect"
        android:drawableStart="@drawable/icon_search_resized"
        android:drawablePadding="8dp"
        android:drawableTint="@color/font"
        android:fontFamily="@font/bobby_jones_condensed"
        android:foreground="@drawable/round_rect_stroke"
        android:foregroundTint="@color/font"
        android:gravity="center_vertical|start"
        android:hint="@string/search"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="@color/font"
        android:textColorHint="@color/darker_font"
        android:textCursorDrawable="@drawable/text_cursor"
        android:textSize="20dp"
        tools:ignore="LabelFor,SpUsage" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFilter_vwSearchToolbar"
        android:layout_width="@dimen/round_button_size"
        android:layout_height="@dimen/round_button_size"
        android:layout_marginEnd="4dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:contentDescription="@string/filter"
        app:backgroundTint="@color/darker_background"
        app:cornerRadius="@dimen/default_corner_radius"
        app:icon="@drawable/icon_filter"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="@dimen/toolbar_button_icon_size"
        app:iconTint="@color/font"
        app:strokeColor="@color/font"
        app:strokeWidth="@dimen/default_stroke_width" />

    <!-- Bouton Trier -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSort_vwSearchToolbar"
        android:layout_width="@dimen/round_button_size"
        android:layout_height="@dimen/round_button_size"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:contentDescription="@string/sort"
        app:backgroundTint="@color/darker_background"
        app:cornerRadius="@dimen/default_corner_radius"
        app:icon="@drawable/icon_sort"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="@dimen/toolbar_button_icon_size"
        app:iconTint="@color/font"
        app:strokeColor="@color/font"
        app:strokeWidth="@dimen/default_stroke_width" />

</LinearLayout>