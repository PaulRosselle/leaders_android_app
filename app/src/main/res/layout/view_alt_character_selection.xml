<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/round_rect_stroke"
    android:backgroundTint="@color/darker_font">

    <com.leaders.app.views.portrait.PortraitView
        android:id="@+id/ptvBase_vwAltCharacterSelection"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp"
        app:displayMode="Hexagonal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.leaders.app.views.portrait.PortraitView
        android:id="@+id/ptvAlt_vwAltCharacterSelection"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:displayMode="Hexagonal"
        app:layout_constraintBottom_toBottomOf="@+id/ptvBase_vwAltCharacterSelection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/imvArrow_vwAltCharacterSelection"
        app:layout_constraintTop_toTopOf="@+id/ptvBase_vwAltCharacterSelection" />

    <ImageView
        android:id="@+id/imvArrow_vwAltCharacterSelection"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:adjustViewBounds="true"
        android:rotation="180"
        app:layout_constraintBottom_toBottomOf="@+id/ptvBase_vwAltCharacterSelection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/ptvBase_vwAltCharacterSelection"
        app:layout_constraintTop_toTopOf="@+id/ptvBase_vwAltCharacterSelection"
        app:srcCompat="@drawable/icon_back"
        app:tint="@color/font" />

    <Switch
        android:id="@+id/swtAlt_vwAltCharacterSelection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:checked="true"
        android:padding="16dp"
        android:thumb="@drawable/seekbar_thumb"
        android:trackTint="@color/switch_track_tint"
        android:trackTintMode="src_over"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="UseSwitchCompatOrMaterialXml" />
</androidx.constraintlayout.widget.ConstraintLayout>