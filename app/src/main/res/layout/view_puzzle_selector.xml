<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    tools:ignore="SpUsage"
    tools:theme="@style/Base.Theme.LeadersAndroidApp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMain_vwPuzzleSelector"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:backgroundTint="@color/darker_background"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/font"
        app:strokeWidth="@dimen/default_stroke_width" />

    <ImageView
        android:id="@+id/imvSolved_vwPuzzleSelector"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        android:adjustViewBounds="true"
        android:alpha="0.5"
        android:contentDescription="@string/checkbox"
        android:tintMode="multiply"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/btnMain_vwPuzzleSelector"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/icon_crown_empty"
        app:tint="@color/app_golden" />

    <TextView
        android:id="@+id/txvName_vwPuzzleSelector"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        android:autoSizeMaxTextSize="20dp"
        android:autoSizeMinTextSize="10dp"
        android:autoSizeStepGranularity="1dp"
        android:autoSizeTextType="uniform"
        android:ellipsize="none"
        android:fontFamily="@font/bobby_jones_condensed"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:shadowColor="@color/black"
        android:shadowRadius="6"
        android:textAlignment="gravity"
        android:textAllCaps="false"
        android:textColor="@color/font"
        android:textSize="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        tools:text="Test puzzle"
        tools:visibility="gone" />

    <TextView
        android:id="@+id/txvAuthor_vwPuzzleSelector"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:autoSizeMaxTextSize="11dp"
        android:autoSizeMinTextSize="6dp"
        android:autoSizeStepGranularity="1dp"
        android:autoSizeTextType="uniform"
        android:ellipsize="none"
        android:fontFamily="@font/bukhari_script"
        android:gravity="center"
        android:maxLines="1"
        android:shadowColor="@color/black"
        android:shadowRadius="6"
        android:textAlignment="gravity"
        android:textColor="@color/font"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/btnMain_vwPuzzleSelector"
        app:layout_constraintTop_toBottomOf="@+id/txvName_vwPuzzleSelector"
        app:layout_constraintVertical_bias="0.0"
        tools:text="par Paul"
        tools:visibility="gone" />

    <TextView
        android:id="@+id/txvId_vwPuzzleSelector"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        android:autoSizeTextType="none"
        android:ellipsize="none"
        android:fontFamily="@font/fredoka_medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:shadowColor="@color/black"
        android:shadowRadius="6"
        android:textAlignment="gravity"
        android:textAllCaps="false"
        android:textColor="@color/font"
        android:textSize="28dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/pdvDifficulty_vwPuzzleSelector"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="123456789"
        tools:visibility="visible" />

    <com.leaders.app.views.puzzle.PuzzleDifficultyView
        android:id="@+id/pdvDifficulty_vwPuzzleSelector"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <ImageView
        android:id="@+id/imvChecked_vwPuzzleSelector"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        android:contentDescription="@string/checkbox"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/btnMain_vwPuzzleSelector"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/unchecked_box"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>