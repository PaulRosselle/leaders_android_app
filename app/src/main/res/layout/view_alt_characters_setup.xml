<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/round_rect">

    <ImageView
        android:id="@+id/imvIcon_vwAltCharactersSetup"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:scaleX="0.8"
        android:scaleY="0.8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/icon_cards"
        app:tint="@color/app_golden" />

    <TextView
        android:id="@+id/txvTitle_vwAltCharactersSetup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/bebas_neue_bold"
        android:includeFontPadding="true"
        android:justificationMode="inter_word"
        android:text="personnages alternatifs"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="22dp"
        app:layout_constraintBottom_toBottomOf="@+id/imvIcon_vwAltCharactersSetup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imvIcon_vwAltCharactersSetup"
        app:layout_constraintTop_toTopOf="@+id/imvIcon_vwAltCharactersSetup" />

    <LinearLayout
        android:id="@+id/llyAltSelections_vwAltCharactersSetup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/txvTitle_vwAltCharactersSetup"
        app:layout_constraintStart_toStartOf="@+id/imvIcon_vwAltCharactersSetup"
        app:layout_constraintTop_toBottomOf="@+id/imvIcon_vwAltCharactersSetup"
        app:layout_constraintVertical_bias="0.0"></LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>