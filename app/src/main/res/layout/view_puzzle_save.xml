<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/round_rect_gloden_outline_bg"
    tools:ignore="SpUsage">

    <EditText
        android:id="@+id/edtName_vwPuzzleSave"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/app_golden"
        android:ems="10"
        android:fontFamily="@font/bobby_jones_condensed"
        android:hint="@string/puzzle_name"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLength="25"
        android:textAlignment="center"
        android:textColor="@color/font"
        android:textColorHint="@color/darker_font"
        android:textSize="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <EditText
        android:id="@+id/edtAuthor_vwPuzzleSave"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        android:backgroundTint="@color/app_golden"
        android:ems="10"
        android:fontFamily="@font/bukhari_script"
        android:hint="@string/anonymous_author"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLength="20"
        android:textAlignment="center"
        android:textColor="@color/font"
        android:textColorHint="@color/darker_font"
        android:textSize="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edtName_vwPuzzleSave"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btnCancel_vwPuzzleSave"
        android:layout_width="@dimen/round_button_size"
        android:layout_height="@dimen/round_button_size"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/darker_background"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/icon_cancel"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="@dimen/round_button_icon_size"
        app:iconTint="@color/font"
        app:layout_constraintBottom_toBottomOf="@+id/btnSave_vwPuzzleSave"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@+id/btnSave_vwPuzzleSave"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edtAuthor_vwPuzzleSave"
        app:layout_constraintVertical_bias="0.0"
        app:strokeColor="@color/font"
        app:strokeWidth="1dp"
        tools:ignore="SpeakableTextPresentCheck" />


    <Button
        android:id="@+id/btnSave_vwPuzzleSave"
        android:layout_width="@dimen/round_button_size"
        android:layout_height="@dimen/round_button_size"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/darker_background"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/icon_save"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="@dimen/round_button_icon_size"
        app:iconTint="@color/font"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edtAuthor_vwPuzzleSave"
        app:layout_constraintVertical_bias="0.0"
        app:strokeColor="@color/font"
        app:strokeWidth="1dp"
        tools:ignore="SpeakableTextPresentCheck" />

</androidx.constraintlayout.widget.ConstraintLayout>