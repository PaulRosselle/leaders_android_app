<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="alert_dialog_theme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">@color/darker_background</item>
        <item name="android:textColor">@color/app_golden</item>
        <item name="android:textColorPrimary">@color/font</item>

        <!-- AppCompat -->
        <item name="buttonBarPositiveButtonStyle">@style/alert_dialog_buttons_theme</item>
        <item name="buttonBarNegativeButtonStyle">@style/alert_dialog_buttons_theme</item>
        <item name="buttonBarNeutralButtonStyle">@style/alert_dialog_buttons_theme</item>

        <!-- Android -->
        <item name="android:buttonBarPositiveButtonStyle">@style/alert_dialog_buttons_theme</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/alert_dialog_buttons_theme</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/alert_dialog_buttons_theme</item>
    </style>

    <style name="alert_dialog_items_theme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">@color/darker_background</item>
        <item name="android:textColor">@color/app_golden</item>
        <item name="android:textColorPrimary">@color/font</item>
    </style>

    <style name="alert_dialog_buttons_theme" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/app_golden</item>
    </style>
</resources>